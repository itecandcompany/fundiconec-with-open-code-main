SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side admin client (used for RPCs like list_open_jobs_for_fundi).
# Find this under Project Settings > API. NEVER expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "true" to show "Continue with Google" on the auth page.
# Requires Google OAuth to be enabled in your Supabase project dashboard.
VITE_ENABLE_GOOGLE_AUTH=false

# Set to "true" to show "Continue as guest" on the auth page.
# Requires Anonymous Sign-ins to be enabled in your Supabase project
# dashboard (Authentication > Providers > Anonymous Sign-Ins).
VITE_ENABLE_GUEST_AUTH=false
